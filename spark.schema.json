{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gdsrvnt/sparks/main/spark.schema.json",
  "title": "spark.json",
  "description": "A JSON array of SPARK records. type is one of s, p, a, r, or k (lowercase). Records have no id key. This schema does not describe the agent skill in SKILL.md.",
  "type": "array",
  "items": { "$ref": "#/$defs/spark" },
  "$defs": {
    "spark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "answer"],
      "properties": {
        "type": { "enum": ["s", "p", "a", "r", "k"] },
        "question": { "type": "string" },
        "answer": { "type": "string" }
      }
    }
  }
}
