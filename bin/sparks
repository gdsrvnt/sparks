#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["jsonschema>=4.18"]
# ///

"""Maintain sparks, snapshot or query the current herdr inventory in SQLite,
and spawn agent personas as pi sessions in herdr.

``sparks add`` adds or replaces one spark by exact question in a list
of sparks. ``--path`` defaults to ``./sparks.json`` in the working directory.
``sparks agent spawn`` reads a persona from ``.sparks/agents.toml`` or
``defaults/agents.toml`` and its model types from ``defaults/model-types.toml``
and ``.sparks/model-types.toml``, and loads ``pi/extensions/sparks-api-error-blocked.ts``.
The spark shape comes from ``sparks.schema.json``. ``spark_id.py`` derives
the id (XXH64 via the dependency-free ``spark_hash.py``), and add stores it
as the spark's optional ``id`` key.
Both modules are read from the repository root, the parent of ``bin/``.
"""

import argparse
import contextlib
import errno
import fnmatch
import json
import math
import os
import re
import secrets
import shutil
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from collections.abc import Iterator
from datetime import datetime, timezone
from pathlib import Path
from typing import TextIO

from jsonschema.validators import validator_for

try:
    import fcntl
except ImportError:  # Windows: no lock, see _locked
    fcntl = None

ROOT = Path(__file__).resolve().parent.parent
sys.path.append(str(ROOT))  # last, so a file in the repository root cannot shadow a module

from spark_id import Spark, SparkFileError, load  # noqa: E402

DEFAULT_PATH = Path("sparks.json")
LOCK_NAME = ".sparks.lock"
SCHEMA = json.loads((ROOT / "sparks.schema.json").read_text(encoding="utf-8"))
VALIDATOR = validator_for(SCHEMA)(SCHEMA)
SHOWN_PROBLEMS = 3  # schema problems listed in one message
PROBLEM_CHARS = 200  # a longer problem is cut in the middle
UNVERIFIED = 3  # exit status: written, but reading it back did not give what was written

ADD_DESCRIPTION = """\
Add or replace one spark in a list of sparks.

The spark must match sparks.schema.json: type is s, p, a, r, or k (any case
on input; written lowercase), with a
question and an answer. Do not pass an id: sparks assigns it on insertion,
as XXH64 (seed 0, 16 lowercase hex) of the compact, key-sorted JSON of answer,
question, and type, computed by the bundled, dependency-free spark_hash.py.
The id is written as the spark's last key and printed. A replacement keeps
the id the spark already stored, so references to it stay valid; a stored
spark without one gets one. A missing file is
created as [] plus the spark. An existing file must itself be a valid list.
An exact question match replaces the entire spark in its current position,
even if type changes; no match appends. Matching uses decoded strings without
trimming, case folding, or Unicode normalization. Multiple exact matches are
refused without writing. An identical spark that already has its id
succeeds without rewriting.
The new file is written to a temp file in the same
directory, validated, moved into place with os.replace, then re-read and
validated again."""

ADD_EPILOG = f"""\
exit status: 0 added or replaced; 1 refused, nothing written; 2 usage error; 3 written, but
the file read back was not what was written.

On POSIX, adds in one directory take turns by locking a short-lived
{LOCK_NAME} file there. Windows has no lock: run one add per file at a time."""


class Rejected(Exception):
    """One stderr line, ``<subject>: <problem>``, and the exit status ``code``.

    Code 1 means nothing was written. Code UNVERIFIED means the write happened.
    """

    def __init__(self, subject: str, problem: str, code: int = 1) -> None:
        super().__init__(f"{subject}: {problem}")
        self.problem = problem
        self.code = code


def _show(value: object) -> str:
    """value as text that stays on one line: its repr if it has control characters."""
    text = str(value)
    return text if text.isprintable() else repr(text)


def _why(exc: OSError) -> str:
    return exc.strerror or str(exc)


def _say(stream: TextIO | None, text: str) -> None:
    """Write a line. A closed, narrow, or broken stream must not change the exit status."""
    if stream is None:  # the process started with this stream closed
        return
    try:
        try:
            stream.write(text)
        except UnicodeEncodeError:  # e.g. a cp1252 pipe and a CJK path
            stream.write(text.encode("ascii", "backslashreplace").decode("ascii"))
        stream.flush()
    except OSError:  # e.g. the reader closed the pipe
        with contextlib.suppress(OSError):  # so the flush at exit cannot fail as well
            os.dup2(os.open(os.devnull, os.O_WRONLY), stream.fileno())


def _object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    found: dict[str, object] = {}
    for key, value in pairs:
        if key in found:
            raise ValueError(f"duplicate key {key!r}")
        found[key] = value
    return found


def _constant(name: str) -> object:
    raise ValueError(f"{name} is not valid JSON")


def _int(text: str) -> int:
    try:
        return int(text)
    except ValueError:  # over Python's limit on digits
        raise ValueError("number has too many digits") from None


def _parse(text: str, label: str) -> object:
    """Parse strict JSON. Duplicate keys are refused: a rewrite would keep only one."""
    try:
        return json.loads(text, object_pairs_hook=_object, parse_constant=_constant, parse_int=_int)
    except json.JSONDecodeError as exc:
        raise Rejected(label, f"invalid JSON: {exc}") from exc
    except ValueError as exc:
        raise Rejected(label, str(exc)) from exc
    except RecursionError as exc:
        raise Rejected(label, "JSON nested too deeply") from exc


def _clip(text: str) -> str:
    """Cut a long problem in the middle, keeping both ends."""
    if len(text) <= PROBLEM_CHARS:
        return text
    keep = (PROBLEM_CHARS - 5) // 2
    return f"{text[:keep]} ... {text[-keep:]}"


def _schema_problems(instance: object, skip: int = 0) -> str:
    """sparks.schema.json problems as ``where: message; ...``, or "" if there are none.

    skip drops leading path parts, such as the index of a spark checked alone.
    """
    try:
        errors = list(VALIDATOR.iter_errors(instance))
    except RecursionError:
        return "JSON nested too deeply"
    shown = []
    for error in errors[:SHOWN_PROBLEMS]:
        parts = list(error.absolute_path)[skip:]
        where = "".join(f"[{p}]" if isinstance(p, int) else f".{p}" for p in parts)
        shown.append(_clip(f"{where.lstrip('.')}: {error.message}" if where else error.message))
    if len(errors) > SHOWN_PROBLEMS:
        shown.append(f"and {len(errors) - SHOWN_PROBLEMS} more")
    return "; ".join(shown)


def _lower_type(spark: object) -> None:
    """Accept a type in any case on input; the canonical, written form is lowercase."""
    if isinstance(spark, dict) and isinstance(spark.get("type"), str):
        spark["type"] = spark["type"].lower()


def parse_spark(text: str) -> dict[str, str]:
    """The --json spark, checked, with keys in the order type, question, answer."""
    spark = _parse(text, "--json")
    if not isinstance(spark, dict):
        raise Rejected("--json", "expected one JSON object, a single spark")
    _lower_type(spark)
    if "id" in spark:
        raise Rejected("--json", "id is assigned by sparks on add; leave it out")
    # The schema describes a list of sparks, so check the spark as a one-item list.
    problems = _schema_problems([spark], skip=1)
    if problems:
        raise Rejected("--json", problems)
    try:
        built = Spark(spark["question"], spark["answer"], spark["type"])
    except SparkFileError as exc:  # spark_id cannot hash a lone surrogate, or a bad type
        raise Rejected("--json", "question and answer must be valid UTF-8 text") from exc
    return {"type": built.type, "question": built.question, "answer": built.answer}


def read_file(path: Path, label: str) -> list[dict[str, str]]:
    """A valid list of sparks: sparks.schema.json, then spark_id.load."""
    try:
        text = path.read_bytes().decode("utf-8")
    except OSError as exc:
        raise Rejected(label, f"cannot read: {_why(exc)}") from exc
    except UnicodeDecodeError as exc:
        raise Rejected(label, "file is not UTF-8") from exc
    sparks = _parse(text, label)
    if isinstance(sparks, list):
        for spark in sparks:
            _lower_type(spark)
    problems = _schema_problems(sparks)
    if problems:
        raise Rejected(label, problems)
    try:
        load(path)
    except SparkFileError as exc:
        raise Rejected(label, str(exc)) from exc
    return sparks


def render(sparks: list[dict[str, str]]) -> str:
    return json.dumps(sparks, ensure_ascii=False, indent=2) + "\n"


def _default_mode() -> int:
    """The mode open() gives a new file: 0o666 minus the umask."""
    umask = os.umask(0)
    os.umask(umask)
    return 0o666 & ~umask


def _discard(path: str | Path) -> None:
    with contextlib.suppress(OSError):
        os.unlink(path)


def _write_atomic(target: Path, text: str, mode: int, label: str) -> None:
    """Write a same-directory temp file, fsync and validate it, then os.replace."""
    try:
        fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=".sparks-", suffix=".tmp")
    except OSError as exc:
        where = _show(target.parent)
        raise Rejected(label, f"cannot create a temp file in {where}: {_why(exc)}") from exc
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        read_file(Path(tmp), f"{label} (new content)")
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except OSError as exc:
        _discard(tmp)
        raise Rejected(label, f"cannot write: {_why(exc)}") from exc
    except BaseException:
        _discard(tmp)
        raise
    if hasattr(os, "O_DIRECTORY"):  # POSIX: make the rename itself durable
        with contextlib.suppress(OSError):
            dir_fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)


def _acquire(lock: Path) -> int:
    """flock the lock file, retrying when its holder removed it while we waited."""
    while True:
        fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o666)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            if os.path.samestat(os.fstat(fd), os.stat(lock)):
                return fd
        except FileNotFoundError:
            pass
        except BaseException:
            os.close(fd)
            raise
        os.close(fd)


@contextlib.contextmanager
def _locked(directory: Path, label: str) -> Iterator[None]:
    """Hold directory/.sparks.lock, so adds in one directory take turns (POSIX).

    The holder removes the lock file before letting go, so none is left behind,
    and a crash cannot leave a held lock. A waiter that then gets the removed
    file sees that the path no longer names it, and tries again.
    """
    if fcntl is None:
        yield
        return
    lock = directory / LOCK_NAME
    try:
        fd = _acquire(lock)
    except OSError as exc:
        raise Rejected(label, f"cannot lock {_show(lock)}: {_why(exc)}") from exc
    try:
        yield
    finally:
        _discard(lock)
        os.close(fd)


def _existing(target: Path, label: str) -> tuple[list[dict[str, str]], int]:
    """The sparks in target and its mode, or [] and a new file's mode if it is missing."""
    if not target.exists():
        return [], _default_mode()
    if not target.is_file():
        raise Rejected(label, "not a regular file")
    if not os.access(target, os.W_OK):
        raise Rejected(label, os.strerror(errno.EACCES))
    return read_file(target, label), stat.S_IMODE(target.stat().st_mode)


def add(path: Path, spark_json: str) -> str:
    """Add or replace by exact question in the file at path and return the spark's id."""
    spark = parse_spark(spark_json)
    label = _show(path)
    try:
        # Write through symlinks, so a linked file is updated, not replaced by a copy.
        target = path.resolve()
    except RuntimeError:  # Python 3.11 and 3.12 raise on a symlink loop
        raise Rejected(label, "cannot resolve symlink") from None
    except OSError as exc:
        raise Rejected(label, f"cannot resolve: {_why(exc)}") from exc
    if target.is_symlink():  # Python 3.13+ returns a link it cannot resolve as is
        raise Rejected(label, "cannot resolve symlink")
    if not target.parent.is_dir():
        raise Rejected(label, f"directory {_show(target.parent)} does not exist")
    with _locked(target.parent, label):
        sparks, mode = _existing(target, label)
        incoming = Spark(spark["question"], spark["answer"], spark["type"])
        matches = [
            i for i, existing in enumerate(sparks)
            if existing["question"] == spark["question"]
        ]
        if len(matches) > 1:
            raise Rejected(
                label,
                f"{len(matches)} sparks have the exact question; "
                "resolve ambiguous matches before adding",
            )
        if matches:
            index = matches[0]
            kept_id = sparks[index].get("id", incoming.id)
            spark = {**spark, "id": kept_id}
            if sparks[index] == spark:
                return kept_id
            sparks[index] = spark
        else:
            spark = {**spark, "id": incoming.id}
            sparks.append(spark)
        _write_atomic(target, render(sparks), mode, label)
        try:
            written = read_file(target, label)
        except Rejected as exc:
            problem = f"written, but invalid when read back: {exc.problem}"
            raise Rejected(label, problem, UNVERIFIED) from exc
        if written != sparks:
            problem = "written, but another program changed it before it was read back"
            raise Rejected(label, problem, UNVERIFIED)
    return spark["id"]


SNAPSHOT_DESCRIPTION = """\
Refresh the shared local SQLite database of current herdr state, not history.

Calls exactly these four commands, non-interactively and in order:
  herdr workspace list
  herdr tab list
  herdr pane list
  herdr agent list
Never runs bare herdr, starts a TUI, attaches, or prompts.
Exits nonzero if herdr is missing or not running. A failed snapshot leaves
previous inventory intact. Each call has a 30-second timeout, overridden by
SPARKS_HERDR_TIMEOUT (a positive finite number of seconds).

Database path: --db, else SPARKS_HERDR_DB, else
$XDG_DATA_HOME/sparks/herdr-state.sqlite when XDG_DATA_HOME is non-empty,
otherwise ~/.local/share/sparks/herdr-state.sqlite.

exit status: 0 snapshot committed; 1 failure; 2 usage error.
"""

# In schema order. "id" is a required, non-empty string; other fields are nullable.
# Nested column prefixes map to keys in agent_session and scroll objects.
HERDR_COLUMNS = {
    "workspace": (
        ("workspace_id", "id"), ("label", "str"), ("number", "int"),
        ("active_tab_id", "str"), ("agent_status", "str"), ("focused", "bool"),
        ("pane_count", "int"), ("tab_count", "int"),
    ),
    "tab": (
        ("tab_id", "id"), ("workspace_id", "id"), ("label", "str"),
        ("number", "int"), ("agent_status", "str"), ("focused", "bool"),
        ("pane_count", "int"),
    ),
    "pane": (
        ("pane_id", "id"), ("workspace_id", "id"), ("tab_id", "id"),
        ("cwd", "str"), ("foreground_cwd", "str"), ("agent_status", "str"),
        ("focused", "bool"), ("revision", "int"), ("terminal_id", "str"),
        ("terminal_title", "str"), ("terminal_title_stripped", "str"),
        ("agent", "str"), ("agent_session_agent", "str"),
        ("agent_session_kind", "str"), ("agent_session_source", "str"),
        ("agent_session_value", "str"), ("restore_error", "str"),
        ("scroll_offset_from_bottom", "int"),
        ("scroll_max_offset_from_bottom", "int"), ("scroll_viewport_rows", "int"),
    ),
    "agent": (
        ("name", "id"), ("pane_id", "id"), ("workspace_id", "id"),
        ("tab_id", "id"), ("agent", "str"), ("agent_status", "str"),
        ("cwd", "str"), ("foreground_cwd", "str"), ("focused", "bool"),
        ("interactive_ready", "bool"), ("revision", "int"), ("terminal_id", "str"),
        ("terminal_title", "str"), ("terminal_title_stripped", "str"),
        ("completion_seq", "int"), ("state_change_seq", "int"),
        ("screen_detection_skipped", "bool"), ("agent_session_agent", "str"),
        ("agent_session_kind", "str"), ("agent_session_source", "str"),
        ("agent_session_value", "str"),
    ),
}


class SnapshotError(Exception):
    """A complete one-line diagnostic, with no spark-add exit status 3."""

    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


def _snapshot_reason(reason: object) -> str:
    """Keep foreign output bounded, printable, and on a single line."""
    return _show(" ".join(str(reason).split()))[:500]


def _herdr_timeout() -> float:
    text = os.environ.get("SPARKS_HERDR_TIMEOUT", "30")
    try:
        timeout = float(text)
        if math.isfinite(timeout) and timeout > 0:
            return timeout
    except ValueError:
        pass
    raise SnapshotError("SPARKS_HERDR_TIMEOUT must be a positive finite number of seconds", 2)


def _herdr_not_running(stdout: str, stderr: str) -> bool:
    try:
        error = json.loads(stderr)
    except (ValueError, RecursionError):
        error = None
    if isinstance(error, dict) and isinstance(error.get("error"), dict):
        if error["error"].get("code") == "server_not_running":
            return True
    text = " ".join(f"{stdout} {stderr}".lower().split())
    return any(phrase in text for phrase in (
        "server is not running", "server not running", "no herdr server is running",
        "no server is running", "herdr is not running",
    ))


def _validate_herdr_rows(group: str, response: object) -> list[tuple]:
    """Validate the envelope and all rows, including values SQLite cannot bind."""
    table = f"{group}s"
    if not isinstance(response, dict) or not isinstance(response.get("result"), dict):
        raise ValueError("expected an object with a result object")
    result = response["result"]
    if result.get("type") != f"{group}_list":
        raise ValueError(f"expected result.type {group}_list")
    if not isinstance(result.get(table), list):
        raise ValueError(f"expected result.{table} to be an array")
    rows = []
    keys = set()
    agent_panes = set()
    for index, obj in enumerate(result[table]):
        where = f"{table}[{index}]"
        if not isinstance(obj, dict):
            raise ValueError(f"{where}: expected an object")
        for nested in ("agent_session", "scroll"):
            # Only validate recognized nested fields on the applicable entities.
            if any(column.startswith(f"{nested}_") for column, _ in HERDR_COLUMNS[group]):
                if nested in obj and not isinstance(obj[nested], dict):
                    raise ValueError(f"{where}.{nested}: expected an object")
        values = []
        for column, kind in HERDR_COLUMNS[group]:
            source = obj
            field = column
            for nested in ("agent_session", "scroll"):
                if column.startswith(f"{nested}_"):
                    source = obj.get(nested, {})
                    field = column[len(nested) + 1:]
                    break
            value = source.get(field)
            if kind == "id":
                if not isinstance(value, str) or not value:
                    raise ValueError(f"{where}.{column}: expected a non-empty string")
            elif value is not None:
                expected = {"str": str, "int": int, "bool": bool}[kind]
                if type(value) is not expected:
                    raise ValueError(f"{where}.{column}: expected {kind} or null")
                if kind == "int" and not -(1 << 63) <= value < (1 << 63):
                    raise ValueError(f"{where}.{column}: integer outside SQLite range")
                if kind == "bool":
                    value = int(value)
            values.append(value)
        if values[0] in keys:
            raise ValueError(f"{where}: duplicate {HERDR_COLUMNS[group][0][0]}")
        keys.add(values[0])
        if group == "agent":
            if values[1] in agent_panes:
                raise ValueError(f"{where}: duplicate pane_id")
            agent_panes.add(values[1])
        raw = json.dumps(obj, ensure_ascii=False, allow_nan=False)
        raw.encode("utf-8")  # Reject lone surrogates before creating/opening the database.
        rows.append((*values, raw))
    return rows


def _collect_herdr(timeout: float) -> dict[str, list[tuple]]:
    executable = shutil.which("herdr")
    if executable is None:
        raise SnapshotError("herdr: command not found")
    inventory = {}
    for group in HERDR_COLUMNS:
        subject = f"herdr {group} list"
        try:
            result = subprocess.run(
                [executable, group, "list"], shell=False, capture_output=True,
                encoding="utf-8", errors="replace", timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            raise SnapshotError(f"{subject}: command timed out") from None
        except OSError as exc:
            raise SnapshotError(f"herdr: {_snapshot_reason(_why(exc))}") from exc
        except (ValueError, OverflowError) as exc:
            raise SnapshotError(f"{subject}: {_snapshot_reason(exc)}") from exc
        if result.returncode:
            if _herdr_not_running(result.stdout, result.stderr):
                raise SnapshotError("herdr is not running")
            reason = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
            raise SnapshotError(f"{subject}: {_snapshot_reason(reason)}")
        try:
            response = _parse(result.stdout, subject)
            inventory[group] = _validate_herdr_rows(group, response)
        except Rejected as exc:
            raise SnapshotError(f"{subject}: {_snapshot_reason(exc.problem)}") from exc
        except (ValueError, RecursionError) as exc:
            raise SnapshotError(f"{subject}: {_snapshot_reason(exc)}") from exc
    return inventory


def _snapshot_path(argument: str | None) -> str:
    if argument is not None:
        return argument
    if "SPARKS_HERDR_DB" in os.environ:
        return os.environ["SPARKS_HERDR_DB"]
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        return str(Path(xdg) / "sparks" / "herdr-state.sqlite")
    try:
        return str(Path.home() / ".local" / "share" / "sparks" / "herdr-state.sqlite")
    except RuntimeError as exc:
        raise SnapshotError(f"database path: {_snapshot_reason(exc)}") from exc


def _snapshot_parents(directory: Path) -> None:
    """Create each missing parent with mkdir mode 0755, not just the leaf parent."""
    missing = []
    while True:
        try:
            mode = directory.stat().st_mode
        except FileNotFoundError:
            missing.append(directory)
            directory = directory.parent
        else:
            if not stat.S_ISDIR(mode):
                raise NotADirectoryError(errno.ENOTDIR, "not a directory", str(directory))
            break
    for directory in reversed(missing):
        try:
            directory.mkdir(mode=0o755)
        except FileExistsError:  # Another writer may have just created this parent.
            if not directory.is_dir():
                raise NotADirectoryError(errno.ENOTDIR, "not a directory", str(directory))


def _snapshot_file(target: Path) -> bool:
    """Refuse non-files; create a missing file privately. Return whether it existed."""
    try:
        mode = target.stat().st_mode
    except FileNotFoundError:
        # Do not follow a dangling symlink and accidentally create its target.
        if target.is_symlink():
            raise ValueError("not a regular file")
    else:
        if not stat.S_ISREG(mode):
            raise ValueError("not a regular file")
        return True
    _snapshot_parents(target.parent)
    try:
        fd = os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        if not stat.S_ISREG(target.stat().st_mode):
            raise ValueError("not a regular file")
        return True
    else:
        os.close(fd)
        if os.name == "posix":
            with contextlib.suppress(OSError):
                os.chmod(target, 0o600)
    return False


def _check_snapshot_version(connection: sqlite3.Connection) -> bool:
    """Read before journal-mode changes, and recheck under the write lock."""
    if connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='meta'").fetchone():
        row = connection.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
        value = row[0] if row else None
        if value != "1":
            raise ValueError(f"unsupported schema_version {value} (expected 1)")
        return True
    return False


def _activate_snapshot_wal(connection: sqlite3.Connection) -> None:
    """Retry only journal-mode contention, within one monotonic five-second budget."""
    deadline = time.monotonic() + 5
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise sqlite3.OperationalError("database is locked")
            # Some WAL transitions wait through SQLite's busy handler, others
            # fail immediately. Keep each attempt within the remaining budget.
            connection.execute(f"PRAGMA busy_timeout={max(1, int(remaining * 1000))}")
            try:
                row = connection.execute("PRAGMA journal_mode=WAL").fetchone()
            except sqlite3.OperationalError as exc:
                code = getattr(exc, "sqlite_errorcode", None)
                if code is not None:
                    locked = (code & 0xff) in (sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED)
                else:
                    locked = str(exc).lower().startswith((
                        "database is locked", "database table is locked",
                        "database schema is locked", "database is busy",
                    ))
                if not locked:
                    raise
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise sqlite3.OperationalError("database is locked") from exc
                time.sleep(min(0.05, remaining))
            else:
                if row is None or row[0] != "wal":
                    raise sqlite3.OperationalError("cannot enable WAL journal mode")
                return
    finally:
        # BEGIN IMMEDIATE and the transaction retain SQLite's full busy timeout.
        connection.execute("PRAGMA busy_timeout=5000")


def _create_snapshot_schema(connection: sqlite3.Connection, has_meta: bool) -> None:
    # execute, not executescript: the latter would implicitly commit the transaction.
    connection.execute("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
    if not has_meta:
        connection.execute("INSERT INTO meta (key, value) VALUES ('schema_version', '1')")
    connection.execute("""CREATE TABLE IF NOT EXISTS snapshot (
        id INTEGER PRIMARY KEY CHECK (id = 1), captured_at TEXT NOT NULL,
        workspace_count INTEGER NOT NULL, tab_count INTEGER NOT NULL,
        pane_count INTEGER NOT NULL, agent_count INTEGER NOT NULL
    )""")
    for group, columns in HERDR_COLUMNS.items():
        definitions = []
        for index, (column, kind) in enumerate(columns):
            sql_type = "INTEGER" if kind in ("int", "bool") else "TEXT"
            constraint = " PRIMARY KEY" if index == 0 else " NOT NULL" if kind == "id" else ""
            if group == "agent" and column == "pane_id":
                constraint += " UNIQUE"
            definitions.append(f"{column} {sql_type}{constraint}")
        definitions.append("raw_json TEXT NOT NULL")
        connection.execute(f"CREATE TABLE IF NOT EXISTS {group}s ({', '.join(definitions)})")
    for table, column, name in (
        ("tabs", "workspace_id", "tabs_workspace"),
        ("panes", "workspace_id", "panes_workspace"),
        ("panes", "tab_id", "panes_tab"),
        ("agents", "workspace_id", "agents_workspace"),
        ("agents", "agent_status", "agents_status"),
    ):
        connection.execute(f"CREATE INDEX IF NOT EXISTS {name} ON {table}({column})")


def _write_snapshot(path: str, inventory: dict[str, list[tuple]]) -> str:
    try:
        target = Path(path)
        if _snapshot_file(target):
            # A read/write connection could checkpoint a refused WAL database on
            # close. Preflight existing targets read-only, with URI path escaping.
            with contextlib.closing(sqlite3.connect(
                target.absolute().as_uri() + "?mode=ro", uri=True,
                timeout=5, isolation_level=None,
            )) as preflight:
                _check_snapshot_version(preflight)
        # An absolute filename avoids SQLite's special :memory: and empty-path meanings.
        # It is only used for opening; the user's spelling is retained in output.
        connection = sqlite3.connect(str(target.absolute()), timeout=5, isolation_level=None)
        committed = False
        try:
            connection.execute("PRAGMA busy_timeout=5000")
            _check_snapshot_version(connection)
            # SQLite requires journal_mode outside a transaction. All schema/data
            # changes below are in one explicit transaction, including the locked
            # version recheck. Commit and rollback remain inside the error boundary.
            _activate_snapshot_wal(connection)
            with connection:
                connection.execute("BEGIN IMMEDIATE")
                captured_at = datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
                _create_snapshot_schema(connection, _check_snapshot_version(connection))
                # A name can change, or two names can swap panes. Remove obsolete
                # ownership before upserts to avoid transient UNIQUE violations.
                connection.executemany(
                    "DELETE FROM agents WHERE pane_id = ? AND name != ?",
                    [(row[1], row[0]) for row in inventory["agent"]],
                )
                for group, fields in HERDR_COLUMNS.items():
                    table = f"{group}s"
                    columns = [column for column, _ in fields] + ["raw_json"]
                    primary = columns[0]
                    placeholders = ", ".join("?" for _ in columns)
                    updates = ", ".join(f"{column}=excluded.{column}" for column in columns[1:])
                    rows = inventory[group]
                    connection.executemany(
                        f"INSERT INTO {table} ({', '.join(columns)}) VALUES ({placeholders}) "
                        f"ON CONFLICT ({primary}) DO UPDATE SET {updates}", rows,
                    )
                    keys = {row[0] for row in rows}
                    # Avoid an IN clause's SQLite parameter limit for a large server.
                    absent = [(key,) for (key,) in connection.execute(f"SELECT {primary} FROM {table}")
                              if key not in keys]
                    connection.executemany(f"DELETE FROM {table} WHERE {primary} = ?", absent)
                connection.execute(
                    "INSERT INTO snapshot VALUES (1, ?, ?, ?, ?, ?) ON CONFLICT (id) DO UPDATE SET "
                    "captured_at=excluded.captured_at, workspace_count=excluded.workspace_count, "
                    "tab_count=excluded.tab_count, pane_count=excluded.pane_count, agent_count=excluded.agent_count",
                    (captured_at, *(len(inventory[group]) for group in HERDR_COLUMNS)),
                )
            committed = True
        finally:
            try:
                connection.close()
            except Exception:
                # Only cleanup remains after a successful commit; it cannot
                # turn the committed snapshot into an unsuccessful CLI result.
                if not committed:
                    raise
        return captured_at
    except (sqlite3.Error, OSError, ValueError) as exc:
        reason = _why(exc) if isinstance(exc, OSError) else str(exc)
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(reason)}") from exc


def snapshot(db: str | None = None) -> str:
    """Fetch and validate everything before any filesystem or database write."""
    timeout = _herdr_timeout()
    path = _snapshot_path(db)
    inventory = _collect_herdr(timeout)
    captured_at = _write_snapshot(path, inventory)
    counts = " ".join(f"{group}s={len(inventory[group])}" for group in HERDR_COLUMNS)
    return f"snapshot {captured_at} {counts} db={_show(path)}"


QUERY_DESCRIPTION = """\
Read the shared herdr snapshot and print a short table. Does not call herdr
and does not write the database or sidecars. Pending journal data or a database
changed during the read is a read failure; retry after the writer closes.

Path: --db, else SPARKS_HERDR_DB, else
$XDG_DATA_HOME/sparks/herdr-state.sqlite when XDG_DATA_HOME is non-empty,
otherwise ~/.local/share/sparks/herdr-state.sqlite.

Views (default summary):
  summary     snapshot time, stored counts, status counts, agents not done
  workspaces  id, number, status, tabs, panes, focus, active tab, label
  tabs        id, workspace, number, status, panes, focus, label
  panes       id, workspace, tab, status, kind, name, cwd, restore error
  agents      status, name, kind, workspace, pane, cwd

Columns are tab-separated, one row per line, with a header row. Whitespace
inside a cell becomes one space. Null is empty. Booleans are 1 or 0.
agent_status is printed as stored, not rolled up. --raw prints each stored
fetch object on its own line instead of the table. It does not apply to summary.

Filters are exact and combine. --status and --workspace apply to every view.
--tab applies to summary, tabs, panes, and agents. --name applies to summary,
panes, and agents. A filter that does not apply is a usage error.

exit status: 0 table printed, including zero matches; 1 read failure; 2 usage error.
"""

# Known statuses stay in this order so a count line is stable when one is zero.
QUERY_STATUSES = ("blocked", "idle", "working", "unknown", "done")
QUERY_AGENT_HEADER = ("status", "name", "kind", "ws", "pane", "cwd")
QUERY_AGENT_ORDER = (
    "CASE agent_status WHEN 'blocked' THEN 0 WHEN 'idle' THEN 1 WHEN 'working' THEN 2 "
    "WHEN 'unknown' THEN 3 WHEN 'done' THEN 4 ELSE 5 END, agent_status, name"
)
QUERY_FILTERS = {
    "summary": {"--status", "--workspace", "--tab", "--name"},
    "workspaces": {"--status", "--workspace"},
    "tabs": {"--status", "--workspace", "--tab"},
    "panes": {"--status", "--workspace", "--tab", "--name"},
    "agents": {"--status", "--workspace", "--tab", "--name"},
}


def _query_cell(value: object) -> str:
    """One TSV cell: null is empty, and control characters cannot break the row."""
    if value is None:
        return ""
    return " ".join(str(value).split())


def _query_status_field(label: str | None, count: int) -> str:
    if label is None:
        return f"null={count}"
    if label and label != "null" and all(ch.isalnum() or ch in "-_." for ch in label):
        return f"{label}={count}"
    return f"{json.dumps(label, ensure_ascii=False)}={count}"


def _query_usage(view: str, status: str | None, workspace: str | None, tab: str | None,
                 name: str | None, raw: bool) -> None:
    if raw and view == "summary":
        raise SnapshotError("--raw does not apply to summary", 2)
    allowed = QUERY_FILTERS[view]
    for flag, value in (("--status", status), ("--workspace", workspace), ("--tab", tab), ("--name", name)):
        if value is not None and flag not in allowed:
            raise SnapshotError(f"{flag} does not apply to {view}", 2)


def _query_where(columns: dict[str, str], status: str | None, workspace: str | None,
                 tab: str | None, name: str | None) -> tuple[str, list[str]]:
    clauses = []
    params: list[str] = []
    for key, value in (("status", status), ("workspace", workspace), ("tab", tab), ("name", name)):
        if value is None:
            continue
        clauses.append(f"{columns[key]} = ?")
        params.append(value)
    if not clauses:
        return "", params
    return " WHERE " + " AND ".join(clauses), params


def _query_file_state(target: Path) -> tuple[int, ...]:
    """Immutable reads must not ignore pending WAL or rollback-journal data."""
    info = target.stat()
    for suffix in ("-wal", "-journal"):
        try:
            size = Path(str(target) + suffix).stat().st_size
        except FileNotFoundError:
            continue
        if size:
            raise SnapshotError("snapshot has pending journal data; retry after the writer closes")
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def _open_query(path: str) -> tuple[sqlite3.Connection, Path, tuple[int, ...]]:
    """Open an existing snapshot read-only. Never creates a file, parent, or sidecar."""
    try:
        target = Path(path)
        if target.is_symlink() and not target.exists():
            raise SnapshotError(f"{_show(path)}: not a regular file")
        if not target.exists():
            raise SnapshotError(f"{_show(path)}: no snapshot")
        if not target.is_file():
            raise SnapshotError(f"{_show(path)}: not a regular file")
        # mode=ro alone can create or update WAL sidecars. Immutable disables
        # that, but ignores journals: refuse pending data and check for concurrent
        # changes after rendering. Resolve symlinks so journal checks match SQLite.
        target = target.resolve(strict=True)
        state = _query_file_state(target)
        connection = sqlite3.connect(
            target.as_uri() + "?mode=ro&immutable=1", uri=True, timeout=5, isolation_level=None,
        )
    except SnapshotError:
        raise
    except (sqlite3.Error, OSError, ValueError) as exc:
        reason = _why(exc) if isinstance(exc, OSError) else str(exc)
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(reason)}") from exc
    try:
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA busy_timeout=5000")
        connection.execute("PRAGMA query_only=ON")
        connection.execute("BEGIN")
        return connection, target, state
    except (sqlite3.Error, OSError, ValueError) as exc:
        with contextlib.suppress(sqlite3.Error, OSError):
            connection.close()
        reason = _why(exc) if isinstance(exc, OSError) else str(exc)
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(reason)}") from exc


def _query_meta(connection: sqlite3.Connection, path: str) -> sqlite3.Row:
    try:
        if not _check_snapshot_version(connection):
            raise SnapshotError(f"{_show(path)}: no snapshot")
        meta = connection.execute(
            "SELECT captured_at, workspace_count, tab_count, pane_count, agent_count "
            "FROM snapshot WHERE id = 1"
        ).fetchone()
        if meta is None:
            raise SnapshotError(f"{_show(path)}: no snapshot")
        counts = [
            connection.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]
            for table in ("workspaces", "tabs", "panes", "agents")
        ]
    except SnapshotError:
        raise
    except ValueError as exc:
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(exc)}") from exc
    except sqlite3.Error as exc:
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(exc)}") from exc
    stored = [meta["workspace_count"], meta["tab_count"], meta["pane_count"], meta["agent_count"]]
    if counts != stored:
        raise SnapshotError(f"{_show(path)}: snapshot counts do not match inventory")
    return meta


def _query_header(meta: sqlite3.Row, path: str, view: str, shown: int, total: int, filtered: bool) -> str:
    captured = _query_cell(meta["captured_at"])
    shown_db = _show(path)
    if view == "summary":
        matched = f" matched={shown}" if filtered else ""
        return (
            f"snapshot {captured} workspaces={meta['workspace_count']} tabs={meta['tab_count']} "
            f"panes={meta['pane_count']} agents={meta['agent_count']}{matched} db={shown_db}"
        )
    extra = "" if shown == total else f" of={total}"
    return f"snapshot {captured} {view}={shown}{extra} db={shown_db}"


def _query_tsv(header: tuple[str, ...], rows: list[tuple]) -> str:
    lines = ["\t".join(header)]
    for row in rows:
        lines.append("\t".join(_query_cell(value) for value in row))
    return "\n".join(lines)


def _query_raw_line(value: object) -> str:
    text = "" if value is None else str(value)
    if "\n" in text or "\r" in text:
        return _query_cell(text)
    return text


def _query_body(connection: sqlite3.Connection, view: str, status: str | None, workspace: str | None,
                tab: str | None, name: str | None, raw: bool) -> tuple[str, int, int]:
    """Return the body, the matching row count, and the unfiltered table count."""
    if view in ("summary", "agents"):
        where, params = _query_where(
            {"status": "agent_status", "workspace": "workspace_id", "tab": "tab_id", "name": "name"},
            status, workspace, tab, name,
        )
        total = connection.execute("SELECT COUNT(*) FROM agents").fetchone()[0]
        if view == "agents" and raw:
            rows = connection.execute(
                f"SELECT raw_json FROM agents{where} ORDER BY {QUERY_AGENT_ORDER}", params,
            ).fetchall()
            return "\n".join(_query_raw_line(row["raw_json"]) for row in rows), len(rows), total
        rows = connection.execute(
            "SELECT agent_status, name, agent, workspace_id, pane_id, cwd "
            f"FROM agents{where} ORDER BY {QUERY_AGENT_ORDER}",
            params,
        ).fetchall()
        visible = rows if view == "agents" else [
            row for row in rows if row["agent_status"] != "done"
        ]
        table = _query_tsv(QUERY_AGENT_HEADER, [
            (row["agent_status"], row["name"], row["agent"], row["workspace_id"], row["pane_id"], row["cwd"])
            for row in visible
        ])
        if view == "agents":
            return table, len(rows), total
        counts: dict[str | None, int] = {}
        for row in rows:
            label = row["agent_status"]
            counts[label] = counts.get(label, 0) + 1
        fields = [_query_status_field(label, counts.pop(label, 0)) for label in QUERY_STATUSES]
        for label in sorted(counts, key=lambda value: (value is not None, value or "")):
            fields.append(_query_status_field(label, counts[label]))
        return "agents " + " ".join(fields) + "\n" + table, len(rows), total

    specs = {
        "workspaces": (
            "workspaces", "raw_json",
            "workspace_id, number, agent_status, tab_count, pane_count, focused, active_tab_id, label",
            "number, workspace_id",
            {"status": "agent_status", "workspace": "workspace_id"},
            ("id", "n", "status", "tabs", "panes", "focus", "active", "label"),
        ),
        "tabs": (
            "tabs", "raw_json",
            "tab_id, workspace_id, number, agent_status, pane_count, focused, label",
            "workspace_id, number, tab_id",
            {"status": "agent_status", "workspace": "workspace_id", "tab": "tab_id"},
            ("id", "ws", "n", "status", "panes", "focus", "label"),
        ),
        "panes": (
            "panes p LEFT JOIN agents a ON a.pane_id = p.pane_id", "p.raw_json",
            "p.pane_id, p.workspace_id, p.tab_id, p.agent_status, p.agent, a.name, p.cwd, p.restore_error",
            "p.workspace_id, p.tab_id, p.pane_id",
            {"status": "p.agent_status", "workspace": "p.workspace_id", "tab": "p.tab_id", "name": "a.name"},
            ("id", "ws", "tab", "status", "kind", "name", "cwd", "restore"),
        ),
    }
    source, raw_column, selected, order, columns, header = specs[view]
    where, params = _query_where(columns, status, workspace, tab, name)
    count_source = "panes" if view == "panes" else source
    total = connection.execute(f"SELECT COUNT(*) FROM {count_source}").fetchone()[0]
    if raw:
        rows = connection.execute(
            f"SELECT {raw_column} AS raw_json FROM {source}{where} ORDER BY {order}", params,
        ).fetchall()
        return "\n".join(_query_raw_line(row["raw_json"]) for row in rows), len(rows), total
    rows = connection.execute(f"SELECT {selected} FROM {source}{where} ORDER BY {order}", params).fetchall()
    return _query_tsv(header, [tuple(row) for row in rows]), len(rows), total


def query(db: str | None = None, view: str = "summary", status: str | None = None,
          workspace: str | None = None, tab: str | None = None, name: str | None = None,
          raw: bool = False) -> str:
    """Read the snapshot and render a short table. Does not call herdr or write."""
    _query_usage(view, status, workspace, tab, name, raw)
    path = _snapshot_path(db)
    connection, target, state = _open_query(path)
    try:
        meta = _query_meta(connection, path)
        body, shown, total = _query_body(connection, view, status, workspace, tab, name, raw)
        header = _query_header(
            meta, path, view, shown, total,
            any(value is not None for value in (status, workspace, tab, name)),
        )
        if _query_file_state(target) != state:
            raise SnapshotError(f"{_show(path)}: snapshot changed while reading; retry")
    except SnapshotError:
        raise
    except (sqlite3.Error, OSError, ValueError) as exc:
        reason = _why(exc) if isinstance(exc, OSError) else str(exc)
        raise SnapshotError(f"{_show(path)}: {_snapshot_reason(reason)}") from exc
    finally:
        with contextlib.suppress(sqlite3.Error, OSError):
            connection.close()
    return header if not body else f"{header}\n{body}"


# sparks agent spawn. The flag checks, effort mapping, provider resolution
# from `pi --list-models`, and herdr launch are adapted from gstack's
# scripts/gstack_spawn (github.com/gdsrvnt/gstack), routed to pi only.
#
# spawn is a thin wrapper over `herdr agent start <name> --kind pi -- <pi args>`:
# everything sparks adds (model, thinking, tools, skills, MCP, the injected
# system prompt) is a pi argument, mapped from the persona's keys to the flags
# pi documents in `pi --help` and in its package docs, docs/cli.md:
#   "Tools" (#tool-options): --tools, --exclude-tools, --no-tools, and
#     "MCP tools" (#mcp-tools): --tools filters MCP tools only once an entry
#     starts with mcp__; --exclude-tools applies to MCP tools too.
#   "Resources" (#resource-options): --no-mcp, --skill, --no-skills
#     ("Explicit --skill paths still load"), -e/--extension.
#   "Prompts and process" (#prompt-and-display-options): --append-system-prompt
#     appends text, or the contents of an existing file, and is repeatable;
#     docs/house/pi/prompt-construction-matrix.md: repeated inputs join with
#     blank lines, and an explicit append bypasses APPEND_SYSTEM.md.

SPAWN_DESCRIPTION = """\
Launch one agent persona as a pi session in a new herdr tab, in the current
directory. spawn is a thin wrapper: it turns the persona into pi arguments and
passes them to herdr agent start --kind pi.

<type> is a persona name: a table in the nearest .sparks/agents.toml, looked
up in the current directory, then in each parent up to the git top level (the
first directory with a .git), or up to the filesystem root outside a git
repository. A name that file does not define, or a missing file, falls back
to the plugin's defaults/agents.toml (spec-writer, implementer, reviewer). A
project file and its .sparks directory must be owned by you and not writable
by group or others. The golden example defaults/agent.toml defines every key.

Model: model_type names a type in the model types: the plugin's
defaults/model-types.toml (value, powerful, fast), extended or overridden by
the nearest .sparks/model-types.toml (same lookup and ownership rule; a type
there replaces the shipped type of that name). A type lists combos, each a pi
provider, model, effort, and optional service_tier, and may name fallback
types. The chain is: the persona's own model, provider, and effort if it sets
model; then the type's combos in order; then each fallback type's combos.
spawn runs pi --list-models once. A combo pi does not list is skipped as
unavailable. A combo whose herdr agent start fails, or whose first request
ends in a pi API error (needs --prompt; see below), has its tab closed, and
the next combo is tried. Every attempt is reported. pi has no service tier
flag: a service_tier is shown in the plan and attempts but not applied.

Each combo becomes:
  pi --provider <provider> --model <model> --thinking <level>
     [--tools <allowed_tools + allowed_mcp> | --no-tools]
     [--exclude-tools <forbidden_tools + forbidden_mcp>] [--no-mcp]
     [--no-skills --skill <dir> ...] -e <plugin>/pi/extensions/sparks-api-error-blocked.ts
     --append-system-prompt <sparks prompt> [--append-system-prompt <directories>]
     [--append-system-prompt <system_prompt>] [<additional flags>]
effort is none (sent as off), minimal, low, medium, high, xhigh ("extra
high", "extra-high", "extrahigh"), or max; ultra is refused. A model pi lists
without thinking only takes none. allowed_tools and forbidden_tools are tool
names or * patterns; allowed_mcp and forbidden_mcp are MCP server names
(sent as mcp__<server>__*) or mcp__ patterns. allowed_mcp = [] is --no-mcp; a
non-empty allowed_mcp needs allowed_tools, because pi filters MCP tools only
inside the --tools allowlist. allowed_tools = [] with no allowed_mcp is
--no-tools. skills names skill directories: each is looked up, first match
wins, in .pi/skills/<name> and .agents/skills/<name> from the current
directory up to the git top level, then the plugin's skills/<name>, then
$PI_CODING_AGENT_DIR (default ~/.pi/agent)/skills/<name> and
~/.agents/skills/<name>; an unknown skill is refused. skills = [] loads no
skill. allowed_directories is sent as an instruction in the system prompt:
pi has no sandbox and does not enforce it.

Every launch gets the sparks prompt: read the sparks.json of every directory
it will read or write, and at the end of its task verify its diff against
the repository-root sparks.json and the sparks.json of each directory the
diff touches. Text appended with --append-system-prompt turns off pi's
APPEND_SYSTEM.md, which pi reads only when no --append-system-prompt is
given; pi's SYSTEM.md is not affected. Each prompt is one line with no tabs
(herdr cannot type a control character into the shell) and must not name an
existing path (pi would read that file instead).

--additional-flags takes one string, split on whitespace, each word appended
to the pi command; quotes and backslashes are ordinary characters. It is
refused if it holds a flag the persona sets (--model, --models, --provider,
--thinking, --effort, --speed, --system-prompt, --append-system-prompt,
--tools, -t, --exclude-tools, -xt, --no-tools, -nt, --no-builtin-tools, -nbt,
--no-mcp, --skill, --no-skills, -ns), a flag that loads or disables
extensions (-e, --extension, --no-extensions, -ne), a flag that stops pi
running interactively or makes it exit (-p, --print, --mode, --export,
--list-models, -h, --help, -v, --version), or --api-key.

Launch: herdr tab create --cwd <cwd> --no-focus (with --workspace
$HERDR_WORKSPACE_ID when set), then herdr agent start <name> --kind pi --pane
<pane> --timeout <ms> -- <pi arguments>; <name> is the persona name, a
hyphen, and four random hex digits, new for each attempt. With --prompt,
spawn then sends the text with herdr agent prompt --wait and watches the
agent for up to --watch seconds. The bundled pi extension marks a pi API
error by reporting blocked through herdr's pi extension and setting the
herdr pane token sparks_api_error; spawn reads it with herdr agent get. A
blocked state without that token (an approval wait) is not an error. Without
--prompt, no request is made, so only a failed start falls back.

Success prints one JSON line with agent, tab, pane, command, model_type,
combo, and attempts. --dry-run runs pi --list-models but no herdr command,
and prints the plan as one JSON line: agent, config, model_types, cwd,
model_type, chain (each combo with available and any reason), chosen,
command, and timeout_ms (and prompt and watch_ms with --prompt)."""

SPAWN_EPILOG = """\
exit status: 0 launched, or plan printed with --dry-run; 1 refused and nothing
launched, no combo available, or every combo failed (the JSON line lists the
attempts and any tab left open); 2 usage error, including a --timeout or
--watch that is not more than 3000 and at most 300000 milliseconds once
rounded to whole milliseconds, and --watch without --prompt."""

AGENTS_FILE = Path(".sparks") / "agents.toml"
MODEL_TYPES_FILE = Path(".sparks") / "model-types.toml"
GOLDEN_AGENTS = "defaults/agent.toml"
DEFAULT_AGENTS = ROOT / "defaults" / "agents.toml"
DEFAULT_MODEL_TYPES = ROOT / "defaults" / "model-types.toml"
API_ERROR_EXTENSION = ROOT / "pi" / "extensions" / "sparks-api-error-blocked.ts"
RUN_TOKEN = "sparks_run"
API_ERROR_TOKEN = "sparks_api_error"  # the herdr pane token the extension sets
# herdr agent names match [a-z][a-z0-9_-]{0,31}; spawn appends "-" and 4 hex digits.
PERSONA_NAME = re.compile(r"[a-z][a-z0-9_-]{0,26}")
TYPE_NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")
PERSONA_STRINGS = ("name", "role", "model_type", "model", "effort", "provider", "system_prompt", "agent")
PERSONA_LISTS = ("allowed_tools", "forbidden_tools", "allowed_mcp", "forbidden_mcp", "skills", "allowed_directories")
PERSONA_KEYS = PERSONA_STRINGS + PERSONA_LISTS
TYPE_KEYS = ("description", "fallback", "combos")
COMBO_KEYS = ("provider", "model", "effort", "service_tier")
# A tool name or * pattern for --tools / --exclude-tools; pi splits the list on commas.
TOOL_PATTERN = re.compile(r"[A-Za-z0-9_.*][A-Za-z0-9_.*-]*")
MCP_SERVER = re.compile(r"[A-Za-z0-9_-]+")  # pi's docs/mcp.md server-name rule
MCP_PATTERN = re.compile(r"mcp__[A-Za-z0-9_*]+")
SKILL_NAME = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")  # the Agent Skills name rule pi follows
PI_THINKING = {
    "none": "off", "minimal": "minimal", "low": "low", "medium": "medium", "high": "high",
    "xhigh": "xhigh", "extra high": "xhigh", "extra-high": "xhigh", "extrahigh": "xhigh",
    "max": "max",
}
THINKING_SUFFIX = re.compile(r":(none|off|minimal|low|medium|high|xhigh|extra-?high|max|ultra)$", re.I)
SPEED_WORDS = frozenset({"fast", "normal", "ultrafast"})
# herdr refuses to type an argument with a control character (a newline, a tab)
# into the pane's shell: "cannot be encoded safely for the target shell".
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")
# Flags the persona sets, and the key that sets each. --models lets pi cycle
# (Ctrl+P) to other models, each with its own :thinking level.
PERSONA_FLAGS = {
    "--model": "model", "--models": "model", "--provider": "provider", "--thinking": "effort",
    "--effort": "effort", "--speed": "model", "--system-prompt": "system_prompt",
    "--append-system-prompt": "system_prompt",
    "--tools": "allowed_tools", "-t": "allowed_tools", "--no-tools": "allowed_tools",
    "-nt": "allowed_tools", "--no-builtin-tools": "allowed_tools", "-nbt": "allowed_tools",
    "--exclude-tools": "forbidden_tools", "-xt": "forbidden_tools",
    "--no-mcp": "allowed_mcp", "--skill": "skills", "--no-skills": "skills", "-ns": "skills",
}
# A denylist, so other pi flags pass through. Each of these breaks the launch:
# pi is no longer an interactive session in the pane, a secret is exposed, or
# an extension could step around the persona's tools, MCP, and prompt.
_EXTENSIONS = (
    "loads or disables pi extensions, which can register tools, replace MCP support, or force "
    "the system prompt outside the persona; spawn loads only its own api-error extension"
)
REFUSED_FLAGS = {
    "-p": "runs pi in print mode, which sends the prompt to the model and exits",
    "--print": "runs pi in print mode, which sends the prompt to the model and exits",
    "--mode": "runs pi without its interactive interface",
    "--export": "makes pi export a session and exit",
    "--list-models": "makes pi list models and exit",
    "-h": "makes pi print its help and exit",
    "--help": "makes pi print its help and exit",
    "-v": "makes pi print its version and exit",
    "--version": "makes pi print its version and exit",
    "--api-key": (
        "would show the key in the command, the pane, and the output; "
        "pi reads keys from the environment or its auth.json"
    ),
    "-e": _EXTENSIONS, "--extension": _EXTENSIONS, "--no-extensions": _EXTENSIONS, "-ne": _EXTENSIONS,
}
# The prompt every spawned worker shares (call 8c5af9b0, Q2, Q3, Q7, Q10).
SPARKS_PROMPT = (
    "You were launched by sparks agent spawn as the {name} persona. Before you read, write, or edit "
    "files in a directory, read the sparks.json in that directory and in each parent directory up to "
    "the repository root, where they exist: each spark is a question and answer about how work in this "
    "project is done, and its answer applies to your work. If a sparks.json answer conflicts with these "
    "instructions or with a skill, the sparks.json answer wins; name the conflict in your final report. "
    "At the end of your task, before you report it done, verify your work just in time: list the files "
    "your diff changes (git status and git diff against the base), load the repository-root sparks.json "
    "and the sparks.json of every directory that holds a changed file, and check the work against each "
    "answer. Write a task-scoped verification skill file just in time under a gitignored location "
    "(for example .sparks/verify/<task>.md): a checklist/procedure scoped to the root and all touched "
    "subdirectory sparks.json files, including applicable ancestors. Confirm that location is ignored "
    "(git check-ignore); do not expose or load unrelated skills. Then run that procedure and report its "
    "path, commands, and results. If your read-only persona or directory restrictions prevent writing "
    "it, provide the procedure and an explicit handoff to the summoning agent to persist and run it; "
    "report the artifact as blocked, not created. In your final report, name the sparks.json files you "
    "checked and quote each spark your work "
    "violates with the file, or say that none does."
)
DIRECTORIES_PROMPT = (
    "Read, write, and edit files only inside these directories and their subdirectories (relative "
    "paths are relative to your working directory): {directories}. If the task needs a file outside "
    "them, stop and say so instead."
)
START_TIMEOUT_MS = 30000  # herdr agent start's own default
WATCH_MS = 60000  # how long spawn watches a prompted agent for an API error
CALL_TIMEOUT = 30  # seconds for pi --list-models and each herdr call but start and prompt
PANE_LINES = 120


class SpawnError(Exception):
    """A complete one-line diagnostic. Nothing was launched, unless the message
    names a herdr tab that was left open."""


def _start_timeout(text: str) -> int:
    """Seconds to the whole milliseconds herdr takes, checked as sent: 3000 < ms <= 300000."""
    try:
        seconds = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number of seconds: {text!r}") from None
    ms = round(seconds * 1000) if math.isfinite(seconds) else None
    if ms is None or not 3000 < ms <= 300000:
        raise argparse.ArgumentTypeError(
            "must be more than 3 and at most 300 seconds, rounded to whole milliseconds"
        )
    return ms


class _Once(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest) is not None:
            parser.error(f"{option_string} may be passed once")
        setattr(namespace, self.dest, values)


def _caller_cwd() -> str:
    """The working directory as the caller spells it: $PWD when it names that directory."""
    cwd = os.getcwd()
    pwd = os.environ.get("PWD")
    if pwd and os.path.isabs(pwd):
        with contextlib.suppress(OSError):
            if os.path.samefile(pwd, cwd):
                return pwd
    return cwd


def _walk(start: Path) -> tuple[list[Path], Path | None]:
    """start and each parent up to the git top level (the first directory with a .git),
    or up to the filesystem root outside a repository; and that top level, if any."""
    walked = []
    for directory in (start, *start.parents):
        walked.append(directory)
        if (directory / ".git").exists():
            return walked, directory
    return walked, None


def _scope(stop: Path | None) -> str:
    return f"up to the git top level {_show(stop)}" if stop else "up to the filesystem root"


def _nearest(start: Path, relative: Path) -> Path | None:
    """The nearest project file, owner-checked, or None."""
    for directory in _walk(start)[0]:
        candidate = directory / relative
        if candidate.is_file():
            _check_owner(candidate)
            return candidate
    return None


def _check_owner(path: Path) -> None:
    """Refuse personas another user wrote or could rewrite: the file and its .sparks directory
    must be owned by the current uid and not writable by group or others."""
    if not hasattr(os, "getuid"):  # Windows has no uid or POSIX mode bits
        return
    uid = os.getuid()
    for item in (path.parent, path):
        try:
            info = item.stat()
        except OSError as exc:
            raise SpawnError(f"{_show(item)}: cannot read: {_why(exc)}") from exc
        if info.st_uid != uid:
            raise SpawnError(f"{_show(item)}: owned by uid {info.st_uid}, not you (uid {uid}); refusing it")
        if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise SpawnError(
                f"{_show(item)}: writable by group or others; refusing it (chmod go-w {_show(item)})"
            )


def _toml(path: Path) -> dict[str, object]:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except OSError as exc:
        raise SpawnError(f"{_show(path)}: cannot read: {_why(exc)}") from exc
    except ValueError as exc:  # TOMLDecodeError, or bytes that are not UTF-8
        raise SpawnError(f"{_show(path)}: invalid TOML: {_snapshot_reason(exc)}") from exc


def _tables(document: dict[str, object]) -> list[str]:
    return [key for key, value in document.items() if isinstance(value, dict)]


def _find_persona(cwd: Path, name: str) -> tuple[dict[str, object], Path]:
    """The persona table and the file it came from: the nearest .sparks/agents.toml,
    or the plugin's defaults/agents.toml when that file does not define the name."""
    project = _nearest(cwd, AGENTS_FILE)
    defaults = _toml(DEFAULT_AGENTS)
    if project is not None:
        personas = _toml(project)
        if isinstance(personas.get(name), dict):
            return personas[name], project
    if isinstance(defaults.get(name), dict):
        return defaults[name], DEFAULT_AGENTS
    shipped = ", ".join(_show(key) for key in _tables(defaults)) or "none"
    if project is None:
        stop = _walk(cwd)[1]
        raise SpawnError(
            f"no persona {_show(name)}: no {AGENTS_FILE} in {_show(cwd)} or a parent {_scope(stop)}, "
            f"and the plugin defaults have only: {shipped}; "
            f"the agent-personas skill creates {AGENTS_FILE} from {GOLDEN_AGENTS}"
        )
    known = ", ".join(_show(key) for key in _tables(personas)) or "none"
    raise SpawnError(f"{_show(project)}: no persona {_show(name)}; personas: {known}; plugin defaults: {shipped}")


def _strings(value: object, where: str, key: str) -> list[str]:
    """A list of distinct, non-empty, one-line strings."""
    if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
        raise SpawnError(f"{where}: {key} must be a list of strings")
    for item in value:
        if not item.strip() or item != item.strip():
            raise SpawnError(f"{where}: {key} has an empty entry or one with spaces around it")
        if CONTROL.search(item):
            raise SpawnError(f"{where}: {key} entry {_show(item)} has a control character")
    duplicate = next((item for i, item in enumerate(value) if item in value[:i]), None)
    if duplicate is not None:
        raise SpawnError(f"{where}: {key} lists {_show(duplicate)} twice")
    return value


def _persona(entry: dict[str, object], name: str, where: str) -> dict[str, object]:
    """The persona, checked against the keys and rules in defaults/agent.toml."""
    if not PERSONA_NAME.fullmatch(name):
        raise SpawnError(f"{where}: a persona name is a lowercase letter, then up to 26 of a-z, 0-9, -, _")
    if "speed" in entry:
        raise SpawnError(f"{where}: personas have no speed")
    unknown = [key for key in entry if key not in PERSONA_KEYS]
    if unknown:
        raise SpawnError(f"{where}: unknown key {_show(unknown[0])}; keys are {', '.join(PERSONA_KEYS)}")
    for key, value in entry.items():
        if key in PERSONA_LISTS:
            _strings(value, where, key)
            continue
        if not isinstance(value, str):
            raise SpawnError(f"{where}: {key} must be a string")
        if not value.strip():
            raise SpawnError(f"{where}: {key} is empty; set it or leave it out")
    if "name" in entry and entry["name"] != name:
        raise SpawnError(
            f"{where}: name is {_show(entry['name'])}; it must equal the table name {_show(name)}"
        )
    for key in ("role", "model_type"):
        if key not in entry:
            raise SpawnError(f"{where}: {key} must be specified")
    if "model" in entry and "effort" not in entry:
        raise SpawnError(f"{where}: effort must be specified with model")
    for key in ("provider", "effort"):
        if key in entry and "model" not in entry:
            raise SpawnError(f"{where}: {key} is set without model; set model too, or leave {key} to the model type")
    agent = entry.get("agent", "pi")
    if agent != "pi":
        raise SpawnError(f"{where}: agent is {_show(agent)}; only pi is supported")
    return entry


def _pi_thinking(effort: str, where: str) -> str:
    text = " ".join(effort.lower().split())
    if text == "ultra":
        raise SpawnError(f"{where}: pi has no ultra thinking level")
    if text not in PI_THINKING:
        raise SpawnError(
            f"{where}: unknown effort {_show(effort)}; "
            "use none, minimal, low, medium, high, xhigh (extra high), or max"
        )
    return PI_THINKING[text]


def _check_model(model: str, where: str) -> None:
    suffix = THINKING_SUFFIX.search(model)
    if suffix:
        raise SpawnError(f"{where}: model must not include effort (found {suffix.group(0)}); set effort")
    speed = [word for word in re.split(r"[^a-z0-9]+", model.lower()) if word in SPEED_WORDS]
    if speed:
        raise SpawnError(f"{where}: model must not include speed (found {speed[0]})")


def _model_types(cwd: Path) -> tuple[dict[str, dict], list[Path]]:
    """The shipped model types, each replaced or joined by the nearest project file's types."""
    files = [DEFAULT_MODEL_TYPES]
    types = {name: (value, DEFAULT_MODEL_TYPES) for name, value in _toml(DEFAULT_MODEL_TYPES).items()}
    project = _nearest(cwd, MODEL_TYPES_FILE)
    if project is not None:
        files.append(project)
        types.update({name: (value, project) for name, value in _toml(project).items()})
    checked = {}
    for name, (value, path) in types.items():
        where = f"{_show(path)}: [{_show(name)}]"
        if not isinstance(value, dict):
            raise SpawnError(f"{_show(path)}: {_show(name)} must be a table, one model type")
        if not TYPE_NAME.fullmatch(name):
            raise SpawnError(f"{where}: a model type name is a lowercase letter, then up to 31 of a-z, 0-9, -, _")
        unknown = [key for key in value if key not in TYPE_KEYS]
        if unknown:
            raise SpawnError(f"{where}: unknown key {_show(unknown[0])}; keys are {', '.join(TYPE_KEYS)}")
        if "description" in value and not isinstance(value["description"], str):
            raise SpawnError(f"{where}: description must be a string")
        fallback = _strings(value.get("fallback", []), where, "fallback")
        combos = value.get("combos")
        if not isinstance(combos, list) or not combos or not all(isinstance(c, dict) for c in combos):
            raise SpawnError(f"{where}: combos must be one or more [[{name}.combos]] tables")
        for index, combo in enumerate(combos):
            at = f"{where} combo {index + 1}"
            unknown = [key for key in combo if key not in COMBO_KEYS]
            if unknown:
                raise SpawnError(f"{at}: unknown key {_show(unknown[0])}; keys are {', '.join(COMBO_KEYS)}")
            for key in ("provider", "model", "effort"):
                if key not in combo:
                    raise SpawnError(f"{at}: {key} must be specified")
            for key, item in combo.items():
                if not isinstance(item, str) or not item.strip():
                    raise SpawnError(f"{at}: {key} must be a non-empty string")
            _check_model(combo["model"], at)
            _pi_thinking(combo["effort"], at)
        checked[name] = {"fallback": fallback, "combos": combos, "where": where}
    for name, value in checked.items():
        for other in value["fallback"]:
            if other == name:
                raise SpawnError(f"{value['where']}: fallback names the type itself")
            if other not in checked:
                raise SpawnError(
                    f"{value['where']}: fallback names unknown model type {_show(other)}; "
                    f"types: {', '.join(checked)}"
                )
    return checked, files


def _chain(entry: dict[str, object], types: dict[str, dict], where: str) -> list[dict[str, str]]:
    """The combos to try, in order: the persona's own model, the type's combos, each fallback type's."""
    start = entry["model_type"]
    if start not in types:
        raise SpawnError(f"{where}: unknown model_type {_show(start)}; types: {', '.join(types)}")
    chain = []
    if "model" in entry:
        own = {"type": "persona", "model": entry["model"].strip(), "effort": entry["effort"]}
        if "provider" in entry:
            own["provider"] = entry["provider"].strip()
        _check_model(own["model"], where)
        _pi_thinking(own["effort"], where)
        chain.append(own)
    for name in (start, *types[start]["fallback"]):
        for combo in types[name]["combos"]:
            step = {"type": name, **combo}
            same = [c for c in chain if (c.get("provider"), c["model"], c["effort"]) ==
                    (step["provider"], step["model"], step["effort"])]
            if not same:
                chain.append(step)
    return chain


def _additional_words(raw: str | None) -> list[str]:
    """Split on whitespace, like gstack spawn. Refuse a flag the persona sets, and a flag
    that would break the interactive launch, expose a secret, or step around the persona."""
    words = raw.split() if raw is not None else []
    for word in words:
        flag = word.split("=", 1)[0]
        if flag in PERSONA_FLAGS:
            raise SpawnError(
                f"--additional-flags: {flag} is set by the persona in {AGENTS_FILE} ({PERSONA_FLAGS[flag]})"
            )
        if flag in REFUSED_FLAGS:
            raise SpawnError(f"--additional-flags: {flag} is refused: it {REFUSED_FLAGS[flag]}")
        if CONTROL.search(word):
            raise SpawnError("--additional-flags: herdr cannot type a control character into the shell")
    return words


def _mcp_pattern(entry: str, where: str, key: str) -> str:
    """An MCP server name as pi's tool pattern mcp__<server>__*, or an mcp__ pattern as is."""
    if entry.startswith("mcp__"):
        if not MCP_PATTERN.fullmatch(entry):
            raise SpawnError(f"{where}: {key} entry {_show(entry)} is not an mcp__ name or * pattern")
        return entry
    if not MCP_SERVER.fullmatch(entry):
        raise SpawnError(f"{where}: {key} entry {_show(entry)} is not an MCP server name (letters, digits, _, -)")
    # docs/mcp.md: characters other than letters, digits, and _ become _ in tool names.
    return f"mcp__{re.sub(r'[^A-Za-z0-9_]', '_', entry)}__*"


def _tool_patterns(entries: list[str], where: str, key: str) -> list[str]:
    for entry in entries:
        if entry.startswith("mcp__"):
            mcp = "allowed_mcp" if key == "allowed_tools" else "forbidden_mcp"
            raise SpawnError(f"{where}: {key} entry {_show(entry)} is an MCP tool; put MCP servers in {mcp}")
        if not TOOL_PATTERN.fullmatch(entry):
            raise SpawnError(
                f"{where}: {key} entry {_show(entry)} is not a tool name or * pattern "
                "(letters, digits, _, ., -, *; no leading + or -)"
            )
    return entries


def _skill_dir(name: str, cwd: Path, where: str) -> Path:
    """The first <root>/<name> with a SKILL.md: project .pi/skills and .agents/skills from cwd up to
    the git top level, then the plugin's skills/, then the user's pi and Agent Skills directories."""
    if not SKILL_NAME.fullmatch(name) or len(name) > 64:
        raise SpawnError(f"{where}: skills entry {_show(name)} is not a skill name (a-z, 0-9, single -)")
    roots = []
    for directory in _walk(cwd)[0]:
        roots += [directory / ".pi" / "skills", directory / ".agents" / "skills"]
    roots.append(ROOT / "skills")
    try:
        home = Path.home()
    except RuntimeError:  # no home directory
        home = None
    agent_dir = os.environ.get("PI_CODING_AGENT_DIR")
    if agent_dir:
        roots.append(Path(agent_dir) / "skills")
    elif home is not None:
        roots.append(home / ".pi" / "agent" / "skills")
    if home is not None:
        roots.append(home / ".agents" / "skills")
    for root in roots:
        if (root / name / "SKILL.md").is_file():
            return root / name
    raise SpawnError(
        f"{where}: no skill {_show(name)} in .pi/skills or .agents/skills up to the git top level, "
        "the plugin's skills/, $PI_CODING_AGENT_DIR/skills (default ~/.pi/agent/skills), or ~/.agents/skills"
    )


def _covers(patterns: list[str], tool: str) -> bool:
    return any(fnmatch.fnmatchcase(tool, pattern) for pattern in patterns)


def _persona_args(entry: dict[str, object], name: str, cwd: str, where: str) -> list[str]:
    """The pi arguments every combo shares: tools, MCP, skills, extension, system prompts."""
    args: list[str] = []
    selective_mcp = "allowed_mcp" in entry or "forbidden_mcp" in entry
    if selective_mcp and any("*" in tool or "?" in tool for tool in entry.get("allowed_tools", [])):
        raise SpawnError(f"{where}: allowed_tools patterns containing * or ? bypass selective MCP restrictions")
    allowed = _tool_patterns(entry.get("allowed_tools", []), where, "allowed_tools")
    forbidden = _tool_patterns(entry.get("forbidden_tools", []), where, "forbidden_tools")
    allowed_mcp = [_mcp_pattern(e, where, "allowed_mcp") for e in entry.get("allowed_mcp", [])]
    forbidden_mcp = [_mcp_pattern(e, where, "forbidden_mcp") for e in entry.get("forbidden_mcp", [])]
    for kind, left, right in (("tool", allowed, forbidden), ("MCP server", allowed_mcp, forbidden_mcp)):
        both = next((item for item in left if item in right), None)
        if both is not None:
            raise SpawnError(f"{where}: {kind} {_show(both)} is both allowed and forbidden")
    if allowed_mcp and "allowed_tools" not in entry:
        raise SpawnError(
            f"{where}: allowed_mcp needs allowed_tools: pi filters MCP tools only inside the --tools "
            "allowlist, which replaces the default tools (pi docs/cli.md, MCP tools)"
        )
    if "allowed_tools" in entry:
        listed = allowed + allowed_mcp
        args += ["--tools", ",".join(listed)] if listed else ["--no-tools"]
    # These tools span all enabled servers; explicit literal allowed_tools
    # entries opt in to unfiltered resource access, not server-scoped access.
    if selective_mcp:
        forbidden = forbidden + [tool for tool in
            ("list_mcp_resources", "list_mcp_resource_templates", "read_mcp_resource")
            if tool not in allowed and tool not in forbidden]
    if forbidden or forbidden_mcp:
        args += ["--exclude-tools", ",".join(forbidden + forbidden_mcp)]
    if entry.get("allowed_mcp") == []:
        args.append("--no-mcp")
    if "skills" in entry:
        skills = entry["skills"]
        if skills:
            # pi lists skills only when read or bash can load them (docs/house/pi/prompt-construction-matrix.md).
            readers = [tool for tool in ("read", "bash") if
                       ("allowed_tools" not in entry or _covers(allowed, tool)) and not _covers(forbidden, tool)]
            if not readers:
                raise SpawnError(f"{where}: skills need the read or bash tool to load, and the persona allows neither")
        args.append("--no-skills")
        for skill in skills:
            args += ["--skill", str(_skill_dir(skill, Path(cwd), where))]
    args += ["-e", str(API_ERROR_EXTENSION)]
    prompts = [SPARKS_PROMPT.format(name=name)]
    if "allowed_directories" in entry and entry["allowed_directories"]:
        prompts.append(DIRECTORIES_PROMPT.format(directories=", ".join(entry["allowed_directories"])))
    elif "allowed_directories" in entry:
        raise SpawnError(f"{where}: allowed_directories is empty; list directories or leave it out")
    if "system_prompt" in entry:
        prompt = entry["system_prompt"]
        if CONTROL.search(prompt):
            raise SpawnError(
                f"{where}: system_prompt must be one line with no tabs: herdr cannot type a control "
                'character into the shell (in a """ string, end each line with \\)'
            )
        prompts.append(prompt)
    for prompt in prompts:
        if os.path.exists(os.path.join(cwd, prompt)):
            # pi reads an existing path as a file instead of using the text.
            raise SpawnError(f"{where}: system_prompt names an existing path; pi would read that file instead")
        args += ["--append-system-prompt", prompt]
    return args


def _run(argv: list[str], timeout: float, what: str) -> subprocess.CompletedProcess:
    executable = shutil.which(argv[0])
    if executable is None:
        raise SpawnError(f"{argv[0]}: command not found")
    try:
        return subprocess.run(
            [executable, *argv[1:]], shell=False, capture_output=True, stdin=subprocess.DEVNULL,
            encoding="utf-8", errors="replace", timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise SpawnError(f"{what}: timed out after {timeout:g} seconds") from None
    except (OSError, ValueError) as exc:
        reason = _why(exc) if isinstance(exc, OSError) else str(exc)
        raise SpawnError(f"{what}: {_snapshot_reason(reason)}") from exc


def _pi_rows(text: str) -> list[dict[str, str]]:
    """Rows of the `pi --list-models` table, keyed by its header (provider, model, ..., thinking)."""
    lines = [line.split() for line in text.splitlines() if line.strip()]
    if not lines or lines[0][:2] != ["provider", "model"]:
        return []
    return [dict(zip(lines[0], cells)) for cells in lines[1:] if len(cells) >= 2]


def _pi_list() -> list[dict[str, str]]:
    listed = _run(["pi", "--list-models"], CALL_TIMEOUT, "pi --list-models")
    if listed.returncode:
        reason = listed.stderr.strip() or listed.stdout.strip() or f"exit {listed.returncode}"
        raise SpawnError(f"pi --list-models failed: {_snapshot_reason(reason)}")
    return _pi_rows(listed.stdout)


def _resolve(step: dict[str, str], rows: list[dict[str, str]], where: str) -> dict[str, object]:
    """The step with its pi row checked: available, or unavailable with the reason."""
    model, provider = step["model"], step.get("provider")
    shown = {key: step[key] for key in ("type", "provider", "model", "effort", "service_tier") if key in step}
    exact = [row for row in rows if row["model"].lower() == model.lower()]
    providers = list(dict.fromkeys(row["provider"] for row in exact))
    if provider is None:
        if len(providers) > 1:
            raise SpawnError(
                f"{where}: more than one pi provider serves {model}; set provider to one of: {', '.join(providers)}"
            )
        row = exact[0] if exact else None
    else:
        row = next((r for r in exact if r["provider"].lower() == provider.lower()), None)
    if row is None:
        name = f"{provider}/{model}" if provider else model
        also = f"; providers that serve it: {', '.join(providers)}" if providers else ""
        return {**shown, "available": False, "reason": f"pi lists no {name}{also}"}
    thinking = _pi_thinking(step["effort"], where)
    if thinking != "off" and row.get("thinking") == "no":
        raise SpawnError(
            f"{where}: pi lists {row['provider']}/{row['model']} without thinking; set effort to none"
            + ("" if step["type"] == "persona" else f" in model type {step['type']}")
        )
    return {**shown, "provider": row["provider"], "model": row["model"], "available": True,
            "pi": ["--provider", row["provider"], "--model", row["model"], "--thinking", thinking]}


def spawn_plan(persona_name: str, additional: str | None, timeout_ms: int,
               prompt: str | None = None, watch_ms: int | None = None) -> dict[str, object]:
    """Everything a launch needs, checked. Calls pi --list-models once, never herdr."""
    words = _additional_words(additional)
    if prompt is not None and (not prompt.strip() or CONTROL.search(prompt)):
        raise SpawnError("--prompt must be one non-empty line: herdr agent prompt submits it with Enter")
    cwd = _caller_cwd()
    entry, path = _find_persona(Path(cwd), persona_name)
    where = f"{_show(path)}: [{persona_name}]"
    entry = _persona(entry, persona_name, where)
    shared = _persona_args(entry, persona_name, cwd, where)
    types, type_files = _model_types(Path(cwd))
    steps = _chain(entry, types, where)
    rows = _pi_list()
    chain = [_resolve(step, rows, where) for step in steps]
    chosen = next((index for index, step in enumerate(chain) if step["available"]), None)
    if chosen is None:
        reasons = "; ".join(f"{step['type']} {step['model']}: {step['reason']}" for step in chain)
        raise SpawnError(f"{where}: no combo for model type {entry['model_type']} is available: {reasons}")
    for step in chain:
        if step["available"]:
            step["command"] = ["pi", *step.pop("pi"), *shared, *words]
    plan = {
        "agent": f"{persona_name}-{secrets.token_hex(2)}",
        "config": str(path),
        "model_types": [str(file) for file in type_files],
        "cwd": cwd,
        "model_type": entry["model_type"],
        "chain": chain,
        "chosen": chosen,
        "command": chain[chosen]["command"],
        "timeout_ms": timeout_ms,
    }
    if prompt is not None:
        plan["prompt"] = prompt
        plan["watch_ms"] = watch_ms or WATCH_MS
    return plan


def _herdr_result(result: subprocess.CompletedProcess, what: str) -> dict:
    text = (result.stdout if result.returncode == 0 else result.stderr or result.stdout).strip()
    try:
        body = json.loads(text)
    except (ValueError, RecursionError):
        body = None
    if result.returncode or not isinstance(body, dict) or body.get("error") or not isinstance(body.get("result"), dict):
        error = body.get("error") if isinstance(body, dict) else None
        detail = error.get("message") if isinstance(error, dict) else error
        raise SpawnError(f"{what} failed: {_snapshot_reason(detail or text or f'exit {result.returncode}')}")
    return body["result"]


def _create_tab(cwd: str) -> tuple[str, str]:
    create = ["herdr", "tab", "create"]
    if os.environ.get("HERDR_WORKSPACE_ID"):
        create += ["--workspace", os.environ["HERDR_WORKSPACE_ID"]]
    create += ["--cwd", cwd, "--no-focus"]
    created = _herdr_result(_run(create, CALL_TIMEOUT, "herdr tab create"), "herdr tab create")
    tab, pane = (
        part.get(key) if isinstance(part, dict) else None
        for part, key in ((created.get("tab"), "tab_id"), (created.get("root_pane"), "pane_id"))
    )
    if not (isinstance(tab, str) and tab and isinstance(pane, str) and pane):
        # herdr has created a tab by now; name it so the caller can close it.
        left = f"; tab {_show(tab)} is left open" if isinstance(tab, str) and tab else ""
        raise SpawnError(f"herdr tab create did not return a tab and its root pane{left}")
    return tab, pane


def _close_tab(tab: str) -> bool:
    try:
        _herdr_result(_run(["herdr", "tab", "close", tab], CALL_TIMEOUT, "herdr tab close"), "herdr tab close")
    except SpawnError as exc:
        _say(sys.stderr, f"sparks: {exc}; tab {tab} is left open\n")
        return False
    return True


def _start(plan: dict[str, object], step: dict[str, object], agent: str, pane: str) -> str | None:
    """Start pi in the pane. None on success, else the problem; herdr's output and the pane go to stderr."""
    start = [
        "herdr", "agent", "start", agent, "--kind", "pi", "--pane", pane,
        "--timeout", str(plan["timeout_ms"]), "--", *step["command"][1:],
    ]
    try:
        # herdr enforces the start timeout; the margin covers its own exit.
        started = _run(start, plan["timeout_ms"] / 1000 + CALL_TIMEOUT, "herdr agent start")
        problem = None if started.returncode == 0 else f"exit {started.returncode}"
        output = (started.stderr or "") + (started.stdout or "") if problem else ""
    except SpawnError as exc:
        problem, output = str(exc), ""
    if problem is None:
        return None
    with contextlib.suppress(SpawnError):
        read = _run(
            ["herdr", "pane", "read", pane, "--source", "recent-unwrapped", "--lines", str(PANE_LINES)],
            CALL_TIMEOUT, "herdr pane read",
        )
        if read.returncode == 0:
            output += read.stdout
    if output:
        _say(sys.stderr, output if output.endswith("\n") else output + "\n")
    return f"start failed ({_snapshot_reason(problem)})"


def _api_error(plan: dict[str, object], pane: str) -> tuple[str | None, bool]:
    """Confirm this run's terminal marker within --watch. bool means keep tab,
    stop fallback: approval, transport failures and unknown outcomes are not API errors."""
    deadline = time.monotonic() + plan["watch_ms"] / 1000
    agent, tokens = {}, {}

    def get_agent() -> tuple[dict, dict]:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise SpawnError("watch expired")
        got = _herdr_result(_run(["herdr", "agent", "get", pane], min(CALL_TIMEOUT, remaining),
                                 "herdr agent get"), "herdr agent get")
        agent = got.get("agent") if isinstance(got.get("agent"), dict) else {}
        tokens = agent.get("tokens") if isinstance(agent.get("tokens"), dict) else {}
        return agent, tokens

    def marker(tokens: dict):
        value = tokens.get(RUN_TOKEN)
        return re.fullmatch(r"(\d+):(ready|running|ok|error|aborted)", value) if isinstance(value, str) else None

    try:
        # Baseline before input avoids accepting a stale terminal result. session_start
        # publishes ready; agent_start increments the sequence even for a successful run.
        while True:
            agent, tokens = get_agent()
            baseline = marker(tokens)
            if baseline is not None and baseline[2] != "running":
                break
            if agent.get("agent_status") == "blocked" and not tokens.get(API_ERROR_TOKEN):
                return "approval block (run baseline unconfirmed); keeping the agent", True
            if deadline - time.monotonic() <= 0.1:
                return "failure to confirm run baseline; keeping the agent", True
            time.sleep(0.1)
        expected = int(baseline[1]) + 1
        prompt = ["herdr", "agent", "prompt", pane, plan["prompt"], "--wait",
                  "--until", "idle", "--until", "blocked", "--until", "done"]
        rejected_block = False
        try:
            sent = _run(prompt, max(0.001, deadline - time.monotonic()), "herdr agent prompt")
        except SpawnError as exc:
            if not str(exc).startswith("herdr agent prompt: timed out"):
                return "prompt transport failed; keeping the agent", True
        else:
            if sent.returncode:
                for text in (sent.stderr, sent.stdout):
                    with contextlib.suppress(ValueError, TypeError):
                        body = json.loads(text)
                        error = body.get("error", {}) if isinstance(body, dict) else {}
                        rejected_block = isinstance(error, dict) and error.get("code") == "agent_blocked"
                        if rejected_block:
                            break
                if not rejected_block:
                    return "prompt submission failed; keeping the agent (not a confirmed API error)", True
        while True:
            agent, tokens = get_agent()
            current = marker(tokens)
            if rejected_block:
                # herdr rejected input before sending any. An existing API-error
                # block can fall back; an approval block must never lose its tab.
                if tokens.get(API_ERROR_TOKEN):
                    return f"api error ({_snapshot_reason(tokens[API_ERROR_TOKEN])}, status {agent.get('agent_status')})", False
                return "approval block (agent_blocked); keeping the agent", True
            if current and int(current[1]) == expected:
                if current[2] == "error" and tokens.get(API_ERROR_TOKEN):
                    return f"api error ({_snapshot_reason(tokens[API_ERROR_TOKEN])}, status {agent.get('agent_status')})", False
                if current[2] == "ok":
                    return None, False
                if current[2] in ("error", "aborted"):
                    return "failure to confirm successful run; keeping the agent", True
            remaining = deadline - time.monotonic()
            if remaining <= 0.1:
                if agent.get("agent_status") == "blocked" and not tokens.get(API_ERROR_TOKEN):
                    return "approval block; keeping the agent", True
                return "failure to confirm run outcome within --watch; keeping the agent", True
            time.sleep(min(0.1, remaining))
    except SpawnError as exc:
        if agent.get("agent_status") == "blocked" and not tokens.get(API_ERROR_TOKEN):
            return f"approval block (last observed; outcome unconfirmed: {_snapshot_reason(exc)}); keeping the agent", True
        return f"failure to confirm run outcome ({_snapshot_reason(exc)}); keeping the agent", True


def spawn(plan: dict[str, object]) -> tuple[int, dict[str, object]]:
    """Try each available combo: open a tab, start pi, and with a prompt watch for an API error.
    A failed combo's tab is closed before the next. Returns (exit status, JSON)."""
    attempts: list[dict[str, object]] = []
    left_open: list[str] = []
    persona = plan["agent"].rsplit("-", 1)[0]
    for index, step in enumerate(plan["chain"]):
        combo = {key: step[key] for key in ("type", "provider", "model", "effort", "service_tier") if key in step}
        if not step["available"]:
            attempts.append({**combo, "result": f"unavailable: {step['reason']}"})
            continue
        agent = plan["agent"] if index == plan["chosen"] else f"{persona}-{secrets.token_hex(2)}"
        tab, pane = _create_tab(plan["cwd"])
        problem = _start(plan, step, agent, pane)
        keep = False
        if problem is None and "prompt" in plan:
            problem, keep = _api_error(plan, pane)
        if keep:
            attempts.append({**combo, "result": problem, "tab": tab, "closed": False})
            _say(sys.stderr, f"sparks: {problem}; tab {tab} is left open; stopping fallback\n")
            return 1, {"agent": agent, "tab": tab, "pane": pane, "model_type": plan["model_type"],
                       "attempts": attempts, "left_open": [tab]}
        if problem is None:
            attempts.append({**combo, "result": "started"})
            out = {"agent": agent, "tab": tab, "pane": pane, "command": step["command"],
                   "model_type": plan["model_type"], "combo": combo, "attempts": attempts}
            return 0, out
        closed = _close_tab(tab)
        if not closed:
            left_open.append(tab)
        attempts.append({**combo, "result": problem, "tab": tab, "closed": closed})
        if not closed:
            _say(sys.stderr, "sparks: cleanup failed; stopping fallback\n")
            return 1, {"agent": None, "model_type": plan["model_type"], "attempts": attempts, "left_open": left_open}
        _say(sys.stderr, f"sparks: {step['type']} {combo['provider']}/{combo['model']} {combo['effort']}: "
                         f"{problem}; tab {tab} {'closed' if closed else 'is left open'}; trying the next combo\n")
    left = f"; tabs left open: {', '.join(left_open)}" if left_open else ""
    _say(sys.stderr, f"sparks: every combo for model type {plan['model_type']} failed{left}\n")
    return 1, {"agent": None, "model_type": plan["model_type"], "attempts": attempts, "left_open": left_open}


def _bind_additional_flags(argv: list[str]) -> list[str]:
    """Bind `--additional-flags <value>` and `--prompt <value>` as one argument: argparse
    would read a value such as "--offline" as an option of its own."""
    if argv[:2] != ["agent", "spawn"]:
        return argv
    bound, index = [], 0
    while index < len(argv):
        if argv[index] in ("--additional-flags", "--prompt") and index + 1 < len(argv):
            bound.append(f"{argv[index]}={argv[index + 1]}")
            index += 2
        else:
            bound.append(argv[index])
            index += 1
    return bound


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sparks",
        description="Keep sparks, read or snapshot current herdr state, and spawn agent personas.",
    )
    commands = parser.add_subparsers(dest="command", required=True, metavar="<command>")
    add_parser = commands.add_parser(
        "add",
        help="add or replace one spark by exact question",
        description=ADD_DESCRIPTION,
        epilog=ADD_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    add_parser.add_argument(
        "--path",
        type=Path,
        default=DEFAULT_PATH,
        metavar="<path>",
        help="list of sparks to update, created if missing (default: ./sparks.json)",
    )
    add_parser.add_argument(
        "--json",
        required=True,
        dest="spark_json",
        metavar="<json>",
        help='one spark: {"type": "s"|"p"|"a"|"r"|"k", "question": ..., "answer": ...}',
    )
    herdr = commands.add_parser(
        "herdr", help="shared local herdr state", description="Shared local herdr state."
    )
    herdr_actions = herdr.add_subparsers(dest="action", required=True, metavar="<action>")
    snapshot_parser = herdr_actions.add_parser(
        "snapshot", help="snapshot the current inventory in SQLite",
        description=SNAPSHOT_DESCRIPTION, formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    snapshot_parser.add_argument(
        "--db", metavar="<path>", help="shared SQLite database path (see precedence below)",
    )
    query_parser = herdr_actions.add_parser(
        "query", help="print a short read-only table",
        description=QUERY_DESCRIPTION, formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    query_parser.add_argument(
        "--db", metavar="<path>", help="shared SQLite database path (same precedence as snapshot)",
    )
    query_parser.add_argument("--status", metavar="<status>", help="exact agent_status")
    query_parser.add_argument("--workspace", metavar="<id>", help="exact workspace_id")
    query_parser.add_argument("--tab", metavar="<id>", help="exact tab_id")
    query_parser.add_argument("--name", metavar="<name>", help="exact agent name")
    query_parser.add_argument(
        "--raw", action="store_true", help="print stored fetch objects instead of the table",
    )
    query_parser.add_argument(
        "view", nargs="?", default="summary", choices=tuple(QUERY_FILTERS),
        help="table to print (default: summary)",
    )
    agent = commands.add_parser(
        "agent", help="agent personas from .sparks/agents.toml or the plugin defaults",
        description="Agent personas from .sparks/agents.toml or the plugin defaults.",
    )
    agent_actions = agent.add_subparsers(dest="action", required=True, metavar="<action>")
    spawn_parser = agent_actions.add_parser(
        "spawn", help="launch a persona as a pi session in a new herdr tab",
        description=SPAWN_DESCRIPTION, epilog=SPAWN_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        # Only the exact --additional-flags spelling is bound as one argument.
        allow_abbrev=False,
    )
    spawn_parser.add_argument(
        "type", metavar="<type>", help="persona name in .sparks/agents.toml or the plugin defaults",
    )
    spawn_parser.add_argument(
        "--additional-flags", action=_Once, metavar="<string>",
        help="pi flags appended to the command, split on whitespace; pass once",
    )
    spawn_parser.add_argument(
        "--timeout", type=_start_timeout, default=START_TIMEOUT_MS, metavar="<seconds>",
        help="herdr agent start timeout, more than 3 and at most 300 (default: 30)",
    )
    spawn_parser.add_argument(
        "--prompt", action=_Once, metavar="<text>",
        help="first prompt, sent with herdr agent prompt; lets spawn see an API error and fall back",
    )
    spawn_parser.add_argument(
        "--watch", type=_start_timeout, action=_Once, metavar="<seconds>",
        help="with --prompt: how long to watch for an API error, more than 3 and at most 300 (default: 60)",
    )
    spawn_parser.add_argument(
        "--dry-run", action="store_true", help="print the plan; call no herdr command",
    )
    parser.spawn_parser = spawn_parser
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    parser = _parser()
    args = parser.parse_args(_bind_additional_flags(argv))
    if args.command == "agent":
        if args.watch is not None and args.prompt is None:
            parser.spawn_parser.error("--watch needs --prompt: without a prompt pi makes no request to watch")
        try:
            plan = spawn_plan(args.type, args.additional_flags, args.timeout, args.prompt, args.watch)
            code, output = (0, plan) if args.dry_run else spawn(plan)
        except SpawnError as exc:
            _say(sys.stderr, f"sparks: {exc}\n")
            return 1
        _say(sys.stdout, json.dumps(output, ensure_ascii=False) + "\n")
        return code
    if args.command == "herdr":
        try:
            if args.action == "snapshot":
                output = snapshot(args.db)
            else:
                output = query(
                    args.db, args.view, status=args.status, workspace=args.workspace,
                    tab=args.tab, name=args.name, raw=args.raw,
                )
        except SnapshotError as exc:
            _say(sys.stderr, f"sparks: {exc}\n")
            return exc.code
        # _say handles OS-level closed/broken pipes; a closed in-process text
        # stream instead raises ValueError. Neither may undo a committed snapshot.
        with contextlib.suppress(ValueError):
            _say(sys.stdout, f"{output}\n")
        return 0
    try:
        spark_id = add(args.path, args.spark_json)
    except Rejected as exc:
        _say(sys.stderr, f"sparks: {exc}\n")
        return exc.code
    except OSError as exc:  # not mapped above, e.g. no access while resolving the path
        _say(sys.stderr, f"sparks: {_show(args.path)}: {_why(exc)}\n")
        return 1
    _say(sys.stdout, f"added {spark_id} to {_show(args.path)}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
